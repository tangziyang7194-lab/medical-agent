# AI 导诊系统 - 环境配置模板
# 复制此文件为 .env 并修改实际值

# ========== 数据库配置 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=患者病历库

# ========== 智谱 AI 配置 ==========
# 获取 API Key: https://open.bigmodel.cn/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=qwen-plus
ZHIPUAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ========== Flask 配置 ==========
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# ========== 向量库配置 ==========
VECTOR_DB_DIR=.vector_db
VECTOR_COLLECTION=medical_cases
VECTOR_EMBED_MODEL=embedding-2

# ========== 学习模块配置 ==========
LEARN_INTERVAL_DAYS=2
LEARN_CASES_PER_RUN=50

# ========== 管理员配置 ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========== SMTP 邮件配置 (可选) ==========
# 用于自动发送诊断报告到邮箱
SMTP_SERVER=
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=